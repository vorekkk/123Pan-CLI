# Developer credentials, obtained from the official 123Pan platform
# Leave these empty in the repository copy; fill them in on your own machine.
PAN123_CLIENT_ID=
PAN123_CLIENT_SECRET=

# Default identity mode: developer or oauth
PAN123_AUTH_MODE=developer

# Third-party application identity (only for OAuth commands)
# PAN123_OAUTH_CLIENT_ID=
# PAN123_OAUTH_CLIENT_SECRET=
# PAN123_OAUTH_REDIRECT_URI=

PAN123_API_TIMEOUT=30
PAN123_TRANSFER_TIMEOUT=120
